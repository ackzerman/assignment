# Server Configuration
PORT=3001
NODE_ENV=development

# Security: CORS allowed origins (comma-separated)
# In production, set this to the deployed frontend URL
# Example: CORS_ORIGINS=https://parcels.example.com
CORS_ORIGINS=

# Security: Rate limiting (each limiter has an independent window + max)
# - General API: 300 requests / 15 minutes
# - Batch creation (POST /api/batches only): 30 requests / 10 minutes
# - Batch polling (GET status/results): 1200 requests / 15 minutes
# Invalid values fall back to these safe defaults (never 0/unlimited/NaN).
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# BATCH_RATE_LIMIT_WINDOW_MS=600000
# BATCH_RATE_LIMIT_MAX=30
# POLLING_RATE_LIMIT_WINDOW_MS=900000
# POLLING_RATE_LIMIT_MAX=1200

# Reliability/backpressure: max queued+active+delayed jobs before 429.
MAX_QUEUE_DEPTH=100

# Orphan recovery: batches older than the grace period with no queue job are
# re-enqueued; reconciliation re-runs on this interval so post-grace orphans
# are eventually recovered while the server keeps running.
# RECOVERY_GRACE_MS=60000
# RECOVERY_INTERVAL_MS=60000

# Batch recovery checkpointing: parcels per chunk + claim lease duration.
# Larger chunks = fewer checkpoint writes; smaller chunks = less recompute per crash.
BATCH_CHUNK_SIZE=500
# Stale PROCESSING chunks (crashed worker) become reclaimable after this long.
CHUNK_LEASE_MS=300000
# Temporary batch state TTL in seconds (meta/input/chunks/results expire).
BATCH_TTL_SECONDS=86400
# Max results returned per results request (frontend paginates with limit/offset).
RESULTS_MAX_LIMIT=1000

# Redis (BullMQ queue + temporary batch state). Redis is never publicly exposed;
# bind it to localhost / private network and set a password in production.
# REDIS_URL takes precedence when set (supports password/TLS params).
# REDIS_URL=redis://:password@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# Local demo without Redis installed: spawns a loopback redis-server binary
# (devDependency). Opt-in only — production must provide real Redis.
# EMBEDDED_REDIS=1

# Observability
LOG_LEVEL=debug
