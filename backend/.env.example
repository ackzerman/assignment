# Server Configuration
PORT=3001
NODE_ENV=development

# Security: CORS allowed origins (comma-separated)
# In production, set this to the deployed frontend URL
# Example: CORS_ORIGINS=https://parcels.example.com
CORS_ORIGINS=

# Security: optional Bearer-token auth for batch resources (Master Phase 11).
# Leave empty for open local development (owner = anonymous).
# Set to enable ownership enforcement: API_TOKENS=team-a-token,team-b-token
API_TOKENS=
# AUTH_TOKEN=single-token-legacy

# Reliability/backpressure (Master): max queued+active+delayed jobs before 429.
MAX_QUEUE_DEPTH=100

# Queue (BullMQ + Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Observability
LOG_LEVEL=debug
